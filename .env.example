# ── Shopify (Partner Dashboard → App → Client credentials) ──────────────────
SHOPIFY_API_KEY="your_client_id_here"
SHOPIFY_API_SECRET="your_client_secret_here"

# Public HTTPS URL of this Remix app (Railway / production host)
SHOPIFY_APP_URL="https://your-app.railway.app"

# Comma-separated scopes (must match shopify.app.toml)
SCOPES="read_products,write_products,write_script_tags,read_script_tags"

# ── Database ────────────────────────────────────────────────────────────────
# Local: SQLite   Production: Postgres connection string from Railway
DATABASE_URL="file:dev.sqlite"

# Optional session encryption (openssl rand -base64 32)
ENCRYPTION_STRING="replace_this_with_a_secure_random_string_min_32_chars"

# ── Odoo backend (required in production) ───────────────────────────────────
# HTTPS or HTTP base URL of your Odoo instance — no trailing slash
ODOO_BASE_URL="https://your-odoo.example.com"

# Optional: only needed for XML-RPC token fallback (prefer custom store-token API)
ODOO_DB="your_odoo_database"
ODOO_ADMIN_USER=""
ODOO_ADMIN_PASS=""

# Optional: shared secret for Odoo provision/store-token HMAC (if configured in Odoo)
ODOO_PROVISION_SECRET=""
