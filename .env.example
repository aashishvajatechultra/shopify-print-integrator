# Shopify API credentials — get these from your Shopify Partner Dashboard
SHOPIFY_API_KEY="your_client_id_here"
SHOPIFY_API_SECRET="your_client_secret_here"

# Your deployed app URL (update after deployment)
SHOPIFY_APP_URL="https://your-app.railway.app"

# Database — SQLite for local dev, Postgres for production
DATABASE_URL="file:dev.sqlite"

# Generate a random 32+ char string: openssl rand -base64 32
ENCRYPTION_STRING="replace_this_with_a_secure_random_string_min_32_chars"
